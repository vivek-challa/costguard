# Choose exactly one for the demo:
LLM_PROVIDER=groq
# groq or ollama

# Groq: put your API key here
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama: install/pull a local model, then use:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local FastAPI mock cloud API
CLOUD_API_URL=http://127.0.0.1:8000

# Freshness threshold in minutes
FRESHNESS_THRESHOLD_MINUTES=30
